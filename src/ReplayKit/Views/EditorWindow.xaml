<Window x:Class="ReplayKit.Views.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ReplayKit — редактор" Width="1180" Height="820" MinWidth="740" MinHeight="480" Loaded="OnLoaded" PreviewKeyDown="OnKey">
 <Border Margin="12" CornerRadius="24" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.24"/></Border.Effect>
  <Grid Margin="24,18,24,22"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="OnDrag"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource TrafficButton}" Background="#FF645B" Click="OnClose" ToolTip="Закрыть редактор"/><Button Style="{StaticResource TrafficButton}" Background="#FFBE43" Click="OnMinimize"/><Button Style="{StaticResource TrafficButton}" Background="#30C94C" Click="OnMaximize"/><TextBlock Text="Редактор" FontWeight="SemiBold" FontSize="19" Margin="12,0,0,0"/></StackPanel><TextBlock Text="Все изменения остаются в памяти" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/></Grid>
   <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center"><StackPanel x:Name="Tools" Orientation="Horizontal">
    <Button Content="Перо" Tag="Pen" Click="OnTool" Padding="13,8"/><Button Content="Стрелка" Tag="Arrow" Click="OnTool" Padding="13,8"/><Button Content="Рамка" Tag="Rectangle" Click="OnTool" Padding="13,8"/><Button Content="Маркер" Tag="Highlight" Click="OnTool" Padding="13,8"/><Button Content="Скрыть" Tag="Redact" Click="OnTool" Padding="13,8"/><Button Content="Текст" Tag="Text" Click="OnTool" Padding="13,8"/><Button Content="Обрезать" Tag="Crop" Click="OnTool" Padding="13,8"/>
    <ComboBox x:Name="ColorPicker" Width="104" Margin="12,0,4,0" SelectedIndex="0"><ComboBoxItem Content="Лиловый" Tag="#8D9FFF"/><ComboBoxItem Content="Красный" Tag="#FF5D66"/><ComboBoxItem Content="Жёлтый" Tag="#FFCB54"/><ComboBoxItem Content="Белый" Tag="#FFFFFF"/><ComboBoxItem Content="Чёрный" Tag="#10131B"/></ComboBox><Slider x:Name="ThicknessSlider" Minimum="2" Maximum="20" Value="5" Width="65" Margin="6,0,4,0" ToolTip="Толщина линии"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" Background="#10131B" CornerRadius="16" Margin="0,8,0,8" Padding="10"><Viewbox Stretch="Uniform"><Canvas x:Name="Surface" Background="Transparent" ClipToBounds="True" MouseLeftButtonDown="OnPointerDown" MouseMove="OnPointerMove" MouseLeftButtonUp="OnPointerUp" LostMouseCapture="OnLostCapture"><Image x:Name="BaseImage" IsHitTestVisible="False"/><Canvas x:Name="Overlay" IsHitTestVisible="False"/></Canvas></Viewbox></Border>
   <Grid Grid.Row="3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Button x:Name="UndoButton" Content="↶" ToolTip="Отменить · Ctrl+Z" Click="OnUndo"/><Button x:Name="RedoButton" Content="↷" ToolTip="Повторить · Ctrl+Y" Click="OnRedo"/><TextBlock x:Name="Dimensions" Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Готово" Click="OnClose"/><Button Content="Сохранить PNG" Click="OnSave"/><Button x:Name="CopyButton" Content="Копировать" Style="{StaticResource PrimaryButton}" Click="OnCopy"/></StackPanel></Grid>
  </Grid>
 </Border>
</Window>
