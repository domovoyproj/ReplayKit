<Window x:Class="ReplayKit.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="ReplayKit — настройки" Width="620" Height="860" ResizeMode="NoResize" Loaded="OnLoaded" PreviewKeyDown="OnKey">
 <Border Margin="12" CornerRadius="26" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><Border.Effect><DropShadowEffect BlurRadius="26" Opacity="0.24" ShadowDepth="4"/></Border.Effect>
  <Grid Margin="28,24,28,24"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="OnDrag"><StackPanel><TextBlock Text="Настройки" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Захват, горячие клавиши и качество" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel><Button Style="{StaticResource IconButton}" Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnClose"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,10,8">
    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Основное"/><TextBlock Text="Оформление" Margin="0,0,0,6" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="Theme" SelectedIndex="0"><ComboBoxItem Content="Системное" Tag="System"/><ComboBoxItem Content="Светлое" Tag="Light"/><ComboBoxItem Content="Тёмное" Tag="Dark"/></ComboBox><CheckBox x:Name="AutoStart" Content="Запускать вместе с Windows" Margin="0,16,0,0" Foreground="{DynamicResource TextBrush}"/></StackPanel></Border>
    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="История экрана"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Длительность" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><ComboBox x:Name="HistoryLength"><ComboBoxItem Content="15 секунд" Tag="15"/><ComboBoxItem Content="30 секунд" Tag="30"/><ComboBoxItem Content="60 секунд" Tag="60"/><ComboBoxItem Content="120 секунд" Tag="120"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Качество JPEG" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><ComboBox x:Name="HistoryQuality"><ComboBoxItem Content="Экономное · 70%" Tag="70"/><ComboBoxItem Content="Компактное · 80%" Tag="80"/><ComboBoxItem Content="Сбалансированное · 88%" Tag="88"/><ComboBoxItem Content="Максимальное · 95%" Tag="95"/></ComboBox></StackPanel></Grid><TextBlock Text="Кадры остаются в оперативной памяти. Большая длительность и качество увеличивают расход RAM." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Горячие клавиши"/><TextBlock Text="Открыть историю" Margin="0,0,0,6" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="HistoryKey" IsReadOnly="True" PreviewKeyDown="OnHotkey" ToolTip="Нажмите сочетание: Ctrl, Alt, Shift или Win + буква, цифра или F1–F24"/><TextBlock Text="Запись / пауза" Margin="0,14,0,6" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="RecordingKey" IsReadOnly="True" PreviewKeyDown="OnHotkey"/><TextBlock Text="Начать / остановить видео" Margin="0,14,0,6" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="VideoKey" IsReadOnly="True" PreviewKeyDown="OnHotkey"/><TextBlock Text="Открыть видеобуфер" Margin="0,14,0,6" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="ReplayKey" IsReadOnly="True" PreviewKeyDown="OnHotkey"/></StackPanel></Border>
    <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Видеозапись"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Частота кадров" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><ComboBox x:Name="Fps" SelectedIndex="1"><ComboBoxItem Content="15 FPS" Tag="15"/><ComboBoxItem Content="30 FPS" Tag="30"/><ComboBoxItem Content="60 FPS" Tag="60"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Качество" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><ComboBox x:Name="Quality" SelectedIndex="1"><ComboBoxItem Content="Компактное" Tag="2"/><ComboBoxItem Content="Сбалансированное" Tag="5"/><ComboBoxItem Content="Высокое" Tag="10"/></ComboBox></StackPanel></Grid><TextBlock Text="Размер" Margin="0,14,0,6" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="VideoSize" SelectedIndex="0"><ComboBoxItem Content="Исходное разрешение" Tag="0"/><ComboBoxItem Content="До 1920 пикселей по ширине" Tag="1920"/><ComboBoxItem Content="До 1280 пикселей по ширине" Tag="1280"/></ComboBox><CheckBox x:Name="SystemAudio" Content="Записывать звук компьютера" Margin="0,16,0,6"/><Slider x:Name="SystemVolume" Minimum="0" Maximum="2" Value="1" ToolTip="Громкость компьютера: 0–200%"/><CheckBox x:Name="Microphone" Content="Записывать микрофон" Margin="0,16,0,6"/><Slider x:Name="MicrophoneVolume" Minimum="0" Maximum="2" Value="1" ToolTip="Громкость микрофона: 0–200%"/></StackPanel></Border>
    <Border Style="{StaticResource SectionCard}"><StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="Видеобуфер в памяти"/><CheckBox x:Name="ReplayEnabled" Content="Хранить последние секунды видео"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Длительность" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><ComboBox x:Name="ReplayLength"><ComboBoxItem Content="15 секунд" Tag="15"/><ComboBoxItem Content="30 секунд" Tag="30"/><ComboBoxItem Content="60 секунд" Tag="60"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Лимит памяти" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><ComboBox x:Name="ReplayMemory"><ComboBoxItem Content="64 МБ" Tag="64"/><ComboBoxItem Content="128 МБ" Tag="128"/><ComboBoxItem Content="256 МБ" Tag="256"/><ComboBoxItem Content="512 МБ" Tag="512"/><ComboBoxItem Content="1024 МБ" Tag="1024"/></ComboBox></StackPanel></Grid><CheckBox x:Name="Economy" Content="Экономичный режим · 960 px, 15 FPS" Margin="0,14,0,0"/><TextBlock Text="Обычный режим: до 1920 px, 30 FPS. При достижении лимита самые старые кадры удаляются." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0"/></StackPanel></Border>
    <TextBlock x:Name="Status" Text="Изменения применятся после сохранения" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,14,4,0" FontSize="12"/>
   </StackPanel></ScrollViewer>
   <Grid Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Esc · закрыть без сохранения" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="11"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" Click="OnClose"/><Button Content="Сохранить изменения" Style="{StaticResource PrimaryButton}" Click="OnSave"/></StackPanel></Grid>
  </Grid>
 </Border>
</Window>
