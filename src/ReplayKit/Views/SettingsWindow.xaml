<Window x:Class="ReplayKit.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="ReplayKit — настройки" Width="570" Height="820" ResizeMode="NoResize" Loaded="OnLoaded" PreviewKeyDown="OnKey">
 <Border Margin="12" CornerRadius="24" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><Border.Effect><DropShadowEffect BlurRadius="22" Opacity="0.2" ShadowDepth="3"/></Border.Effect>
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="OnDrag"><TextBlock Text="Настройки" FontSize="22" FontWeight="SemiBold"/><Button Content="×" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnClose"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,12,0">
    <TextBlock Text="Оформление" Margin="0,0,0,8"/><ComboBox x:Name="Theme" SelectedIndex="0"><ComboBoxItem Content="Системное" Tag="System"/><ComboBoxItem Content="Светлое" Tag="Light"/><ComboBoxItem Content="Тёмное" Tag="Dark"/></ComboBox>
    <CheckBox x:Name="AutoStart" Content="Запускать вместе с Windows" Margin="0,20,0,20" Foreground="{DynamicResource TextBrush}"/>
    <TextBlock Text="Открыть историю" Margin="0,0,0,8"/><TextBox x:Name="HistoryKey" IsReadOnly="True" PreviewKeyDown="OnHotkey" ToolTip="Нажмите сочетание: Ctrl, Alt, Shift или Win + буква, цифра или F1–F24"/>
    <TextBlock Text="Запись / пауза" Margin="0,18,0,8"/><TextBox x:Name="RecordingKey" IsReadOnly="True" PreviewKeyDown="OnHotkey"/>
    <TextBlock Text="Начать / остановить видео" Margin="0,18,0,8"/><TextBox x:Name="VideoKey" IsReadOnly="True" PreviewKeyDown="OnHotkey"/>
    <TextBlock Text="Открыть видеобуфер" Margin="0,18,0,8"/><TextBox x:Name="ReplayKey" IsReadOnly="True" PreviewKeyDown="OnHotkey"/>
    <TextBlock Text="Видеозапись" FontSize="18" Margin="0,24,0,12"/>
    <TextBlock Text="Частота кадров"/><ComboBox x:Name="Fps" SelectedIndex="1"><ComboBoxItem Content="15 FPS" Tag="15"/><ComboBoxItem Content="30 FPS" Tag="30"/><ComboBoxItem Content="60 FPS" Tag="60"/></ComboBox>
    <TextBlock Text="Размер" Margin="0,12,0,4"/><ComboBox x:Name="VideoSize" SelectedIndex="0"><ComboBoxItem Content="Исходное разрешение" Tag="0"/><ComboBoxItem Content="До 1920 пикселей по ширине" Tag="1920"/><ComboBoxItem Content="До 1280 пикселей по ширине" Tag="1280"/></ComboBox>
    <TextBlock Text="Качество" Margin="0,12,0,4"/><ComboBox x:Name="Quality" SelectedIndex="1"><ComboBoxItem Content="Компактное" Tag="2"/><ComboBoxItem Content="Сбалансированное" Tag="5"/><ComboBoxItem Content="Высокое" Tag="10"/></ComboBox>
    <CheckBox x:Name="SystemAudio" Content="Записывать звук компьютера" Margin="0,16,0,6"/><Slider x:Name="SystemVolume" Minimum="0" Maximum="2" Value="1" ToolTip="Громкость компьютера: 0–200%"/>
    <CheckBox x:Name="Microphone" Content="Записывать микрофон" Margin="0,16,0,6"/><Slider x:Name="MicrophoneVolume" Minimum="0" Maximum="2" Value="1" ToolTip="Громкость микрофона: 0–200%"/>
    <TextBlock Text="Видеобуфер в памяти" FontSize="18" Margin="0,24,0,12"/>
    <CheckBox x:Name="ReplayEnabled" Content="Хранить последние секунды видео"/>
    <TextBlock Text="Длительность" Margin="0,12,0,4"/><ComboBox x:Name="ReplayLength"><ComboBoxItem Content="15 секунд" Tag="15"/><ComboBoxItem Content="30 секунд" Tag="30"/><ComboBoxItem Content="60 секунд" Tag="60"/></ComboBox>
    <TextBlock Text="Лимит сжатого видеобуфера" Margin="0,12,0,4"/><ComboBox x:Name="ReplayMemory"><ComboBoxItem Content="64 МБ" Tag="64"/><ComboBoxItem Content="128 МБ" Tag="128"/><ComboBoxItem Content="256 МБ" Tag="256"/><ComboBoxItem Content="512 МБ" Tag="512"/><ComboBoxItem Content="1024 МБ" Tag="1024"/></ComboBox>
    <CheckBox x:Name="Economy" Content="Экономичный режим · 960 px, 15 FPS" Margin="0,14,0,0"/>
    <TextBlock Text="Обычный режим: до 1920 px, 30 FPS. При достижении лимита памяти история сокращается. Открытый просмотр хранится отдельно. Звук использует настройки выше." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,8"/>
    <TextBlock x:Name="Status" Text="Нажмите новое сочетание в поле" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0" FontSize="12"/>
   </StackPanel></ScrollViewer>
   <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" Click="OnClose"/><Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="OnSave"/></StackPanel>
  </Grid>
 </Border>
</Window>
