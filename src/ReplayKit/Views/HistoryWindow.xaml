<Window x:Class="ReplayKit.Views.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ReplayKit — история" Width="1160" Height="830" MinWidth="680" MinHeight="480" PreviewKeyDown="OnKey" Loaded="OnLoaded">
 <Border Margin="12" CornerRadius="24" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
  <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.24"/></Border.Effect>
  <Grid Margin="24,18,24,22">
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="70"/><RowDefinition Height="72"/><RowDefinition Height="58"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="OnDrag">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource TrafficButton}" Background="#FF645B" ToolTip="Закрыть · Esc" AutomationProperties.Name="Закрыть" Click="OnClose"/><Button Style="{StaticResource TrafficButton}" Background="#FFBE43" ToolTip="Свернуть" AutomationProperties.Name="Свернуть" Click="OnMinimize"/><Button Style="{StaticResource TrafficButton}" Background="#30C94C" ToolTip="Развернуть" AutomationProperties.Name="Развернуть" Click="OnMaximize"/><TextBlock Text="ReplayKit" FontWeight="SemiBold" FontSize="19" Margin="12,0,0,0"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="CaptureState" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="↻" Padding="10,5" ToolTip="Обновить снимок истории" Click="OnRefresh"/><Button Content="⚙" Padding="10,5" ToolTip="Настройки" AutomationProperties.Name="Настройки" Click="OnSettings"/></StackPanel>
   </Grid>
   <Border Grid.Row="1" Background="#10131B" CornerRadius="16" ClipToBounds="True" Margin="0,14,0,10">
    <Grid><Image x:Name="Preview" Stretch="Uniform" Margin="8"/><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="EmptyTitle" Text="Ваша последняя минута" Foreground="#F2F4FF" FontSize="25" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyHint" Text="Первый кадр появится через секунду" Foreground="#A0ACC6" Margin="0,12,0,0" HorizontalAlignment="Center"/></StackPanel></Grid>
   </Border>
   <Grid Grid.Row="2" PreviewMouseWheel="OnWheel">
    <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <TextBlock Text="ПОСЛЕДНЯЯ МИНУТА" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
    <TextBlock x:Name="RelativeTime" Text="0 секунд" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
    <Slider x:Name="Timeline" Grid.Row="1" Minimum="-59" Maximum="0" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="OnTimeline" AutomationProperties.Name="Секунда истории"/>
    <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="0,24,0,-14" IsHitTestVisible="False"><TextBlock Text="−59 с" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="−30 с" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="сейчас" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid>
   </Grid>
   <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,14,0,0"><StackPanel x:Name="Filmstrip" Orientation="Horizontal" HorizontalAlignment="Center"/></ScrollViewer>
   <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><ComboBox x:Name="Monitors" Width="175" SelectionChanged="OnMonitor" AutomationProperties.Name="Монитор"/><StackPanel Margin="14,1,0,0" VerticalAlignment="Center"><TextBlock x:Name="FrameTime" FontWeight="SemiBold"/><TextBlock x:Name="FrameDetails" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="EditButton" Content="Редактировать" Click="OnEdit" ToolTip="E"/><Button x:Name="SaveButton" Content="Сохранить" Click="OnSave" ToolTip="Ctrl+S"/><Button x:Name="CopyButton" Style="{StaticResource PrimaryButton}" Content="Копировать" Click="OnCopy" ToolTip="Ctrl+C"/></StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>
