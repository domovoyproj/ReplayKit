<Window x:Class="ReplayKit.Views.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="ReplayKit — история" Width="1180" Height="850" MinWidth="640" MinHeight="500" PreviewKeyDown="OnKey" Loaded="OnLoaded" SizeChanged="OnWindowSize">
 <Border Margin="12" CornerRadius="26" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
  <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.26"/></Border.Effect>
  <Grid Margin="26,20,26,24">
   <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="76"/><RowDefinition Height="76"/><RowDefinition Height="Auto" MinHeight="62"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="OnDrag">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button Style="{StaticResource TrafficButton}" Background="#FF645B" ToolTip="Закрыть · Esc" AutomationProperties.Name="Закрыть" Click="OnClose"/>
     <Button Style="{StaticResource TrafficButton}" Background="#FFBE43" ToolTip="Свернуть" AutomationProperties.Name="Свернуть" Click="OnMinimize"/>
     <Button Style="{StaticResource TrafficButton}" Background="#30C94C" ToolTip="Развернуть" AutomationProperties.Name="Развернуть" Click="OnMaximize"/>
     <StackPanel x:Name="AppTitle" Margin="14,0,0,0"><TextBlock Text="История экрана" FontWeight="SemiBold" FontSize="19"/><TextBlock Text="Выберите момент, который хотите сохранить" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Border Style="{StaticResource StatusPill}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0"/><TextBlock x:Name="CaptureState" FontSize="12" VerticalAlignment="Center"/></StackPanel></Border>
     <Button x:Name="VideoButton" Content="● Видео" Padding="13,7" ToolTip="Начать или остановить запись MP4" Click="OnVideo"/>
     <Button Style="{StaticResource IconButton}" Content="↻" ToolTip="Обновить снимок истории" Click="OnRefresh"/>
     <Button Style="{StaticResource IconButton}" Content="⚙" ToolTip="Настройки" AutomationProperties.Name="Настройки" Click="OnSettings"/>
    </StackPanel>
   </Grid>
   <Border Grid.Row="1" Background="#0B0E16" CornerRadius="18" ClipToBounds="True" Margin="0,14,0,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
    <Grid>
     <Image x:Name="Preview" Stretch="Uniform" Margin="10"/>
     <Border x:Name="LoadingBadge" Style="{StaticResource StatusPill}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Visibility="Collapsed"><TextBlock Text="Загрузка кадра…" FontSize="11"/></Border>
     <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="EmptyTitle" Text="Ваша последняя минута" Foreground="#F2F4FF" FontSize="25" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyHint" Text="Первый кадр появится через секунду" Foreground="#A0ACC6" Margin="0,12,0,0" HorizontalAlignment="Center"/></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="2" PreviewMouseWheel="OnWheel">
    <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><TextBlock x:Name="TimelineCaption" Text="ИСТОРИЯ · 60 СЕКУНД" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Border Margin="10,0,0,0" Padding="8,3" CornerRadius="8" Background="{DynamicResource PanelBrush}"><TextBlock x:Name="FrameCounter" Text="0 кадров" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></Border></StackPanel>
    <TextBlock x:Name="RelativeTime" Text="0 секунд" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
    <Slider x:Name="Timeline" Grid.Row="1" Minimum="-59" Maximum="0" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="OnTimeline" AutomationProperties.Name="Секунда истории"/>
    <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="0,25,0,-14" IsHitTestVisible="False"><TextBlock x:Name="OldestLabel" Text="−59 с" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="MiddleLabel" Text="−30 с" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="сейчас" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></Grid>
   </Grid>
   <Border Grid.Row="3" Style="{StaticResource SectionCard}" Margin="0,12,0,0" Padding="10,9"><ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Filmstrip" Orientation="Horizontal" HorizontalAlignment="Center"/></ScrollViewer></Border>
   <Grid x:Name="Footer" Grid.Row="4" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><ComboBox x:Name="Monitors" Width="190" SelectionChanged="OnMonitor" AutomationProperties.Name="Монитор"/><StackPanel Margin="14,1,0,0" VerticalAlignment="Center"><TextBlock x:Name="FrameTime" FontWeight="SemiBold"/><TextBlock x:Name="FrameDetails" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel></StackPanel>
    <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Ещё" Click="OnMore"/><Button x:Name="EditButton" Content="Редактировать" Click="OnEdit" ToolTip="E"/><Button x:Name="SaveButton" Content="Сохранить" Click="OnSave" ToolTip="Ctrl+S"/><Button x:Name="CopyButton" Style="{StaticResource PrimaryButton}" Content="Копировать" Click="OnCopy" ToolTip="Ctrl+C"/></StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>
